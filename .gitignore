# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) - except .env.local.example, which is a
# committed template with no real secrets in it (see its own contents)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# duckdb - history.duckdb IS committed (via Git LFS - see .gitattributes) since it's the compact,
# pre-aggregated data the deployed app reads directly; nothing rebuilds it in production. Only the
# transient WAL file and any other stray .duckdb file (e.g. a local scratch DB) stay ignored.
/db/*.duckdb
!/db/history.duckdb
/db/*.duckdb.wal

# ML experiment virtualenv and artifacts
ml/.venv/
ml/cache/
ml/*.log
__pycache__/

# Output of scripts/precompute-predictions.ts - only meaningful on the "data" branch (see
# .github/workflows/precompute-predictions.yml, lib/precomputed-predictions.ts), where the workflow
# force-adds it past this rule. A local dry run of the script elsewhere just produces a scratch file.
/predictions.json
