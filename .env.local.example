# Folder containing poe.ninja historical CSV export (<League>/<League>.{currency,items}.csv).
# Defaults to ../poe-pricing/data if unset.
POE_DATA_DIR=C:\Users\Wesley\Documents\Projects\poe-pricing\data

# Shared password required to use the app (see proxy.ts / lib/site-auth.ts) - not real per-user
# auth, just a gate since this is shared with a handful of people. Required - there's no default;
# unset, the login page rejects every attempt. Also set this in the Vercel project's Environment
# Variables for deployment (Project Settings -> Environment Variables).
SITE_PASSWORD=changeme
